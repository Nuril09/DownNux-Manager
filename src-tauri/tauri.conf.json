{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "DownNux Manager",
  "version": "0.0.4",
  "identifier": "com.hoodtech.downnux",
  "build": {
    "beforeDevCommand": "npm --prefix apps/gui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../apps/gui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DownNux Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "aria2",
          "libwebkit2gtk-4.1-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.png"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}