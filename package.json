{
  "name": "downnux-manager",
  "private": true,
  "version": "0.0.5",
  "description": "DownNux Manager — Modern High-Speed Download Accelerator by HoodTech",
  "author": "HoodTech <https://github.com/Nuril09/DownNux-Manager>",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "daemon": "tsx apps/daemon/src/main.ts",
    "cli": "tsx apps/daemon/src/cli.ts",
    "gui": "npm --prefix apps/gui run dev",
    "gui:build": "npm --prefix apps/gui run build",
    "range-server": "tsx tools/range-server/server.ts",
    "test": "node --import tsx --test apps/daemon/test/*.test.ts",
    "typecheck": "tsc -p .",
    "measure-mem": "tsx scripts/measure-mem.ts",
    "install-dev": "bash scripts/install-dev.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
