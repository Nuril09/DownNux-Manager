{
  "manifest_version": 3,
  "name": "DownNux Manager — Browser Integration",
  "short_name": "DownNux",
  "version": "0.0.4",
  "description": "Capture downloads and video streams automatically for DownNux Manager by HoodTech.",
  "author": "HoodTech",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "webRequest",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Unduh",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": ""
}
