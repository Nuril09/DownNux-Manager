{
  "manifest_version": 3,
  "name": "DownNux Manager — Browser Integration",
  "short_name": "DownNux",
  "version": "0.0.8",
  "description": "Capture downloads, video streams, and audio tracks (YouTube, Spotify, SoundCloud, Bandcamp) for DownNux Manager by HoodTech.",
  "author": "HoodTech",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DownNux Manager",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downnux@creativemichiz.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}

